[
 {
  "title": "靜夜思",
  "author": "李白",
  "url": "https://zh.wikisource.org/wiki/靜夜思",
  "lines": [
   "牀前看月光，",
   "疑是地上霜。",
   "舉頭望山月，",
   "低頭思故鄉。"
  ],
