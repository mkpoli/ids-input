{
  "name": "ids-input",
  "version": "0.1.0",
  "description": "Headless editing of ideographic description sequences (IDS): parse, write and edit IDS trees, with Svelte components for an editor, a parts palette, a decomposition browser and a preview drawn by han-compose.",
  "license": "MIT",
  "author": "mkpoli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mkpoli/ids-input.git"
  },
  "homepage": "https://mkpoli.github.io/ids-input/",
  "keywords": [
    "ids",
    "ideographic description sequence",
    "cjk",
    "han",
    "kanji",
    "hanzi",
    "input",
    "svelte"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./types/core/index.d.ts",
      "default": "./src/core/index.js"
    },
    "./adapter": {
      "types": "./types/adapter/index.d.ts",
      "default": "./src/adapter/index.js"
    },
    "./composer": {
      "types": "./types/composer/index.d.ts",
      "default": "./src/composer/index.js"
    },
    "./svelte": {
      "svelte": "./src/svelte/index.js",
      "default": "./src/svelte/index.js"
    },
    "./messages/*": "./messages/*",
    "./fonts.css": "./fonts/fonts.css",
    "./fonts/*": "./fonts/*",
    "./data/*": "./data/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "types",
    "data",
    "fonts",
    "messages",
    "scripts",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "bun test tests",
    "types": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit && svelte-check --tsconfig ./tsconfig.svelte.json --threshold warning",
    "dev": "vite demo",
    "build:demo": "vite build demo",
    "preview": "vite preview demo",
    "demo:check": "bun demo/check.js",
    "prepack": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/bun": "1.3.14",
    "playwright-core": "1.64.1",
    "qrcode-generator": "1.4.4",
    "svelte": "5.57.0",
    "svelte-check": "4.7.7",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "peerDependencies": {
    "svelte": "^5.20.0"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  }
}
