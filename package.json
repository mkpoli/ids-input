{
  "name": "ids-input",
  "version": "0.1.0",
  "description": "Headless editing of ideographic description sequences (IDS): parse, write and edit IDS trees, with Svelte components for an editor, a parts palette, a decomposition browser and a preview drawn by han-compose.",
  "license": "MIT",
  "author": "mkpoli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mkpoli/ids-input.git"
  },
  "homepage": "https://ids.mkpo.li/",
  "keywords": [
    "ids",
    "ideographic description sequence",
    "cjk",
    "han",
    "kanji",
    "hanzi",
    "input",
    "svelte"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./types/core/index.d.ts",
      "default": "./src/core/index.js"
    },
    "./adapter": {
      "types": "./types/adapter/index.d.ts",
      "default": "./src/adapter/index.js"
    },
    "./composer": {
      "types": "./types/composer/index.d.ts",
      "default": "./src/composer/index.js"
    },
    "./document": {
      "types": "./types/document/index.d.ts",
      "default": "./src/document/index.js"
    },
    "./svelte": {
      "svelte": "./src/svelte/index.js",
      "default": "./src/svelte/index.js"
    },
    "./messages/*": "./messages/*",
    "./fonts.css": "./fonts/fonts.css",
    "./fonts/*": "./fonts/*",
    "./data/*": "./data/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "types",
    "data",
    "fonts",
    "messages",
    "scripts",
    "LICENSE",
    "README.md",
    "docs/document-format.md",
    "docs/gongche-coverage.md",
    "docs/small-seal-candidates.md",
    "docs/ids-document.schema.json",
    "docs/ids-document.example.json"
  ],
  "scripts": {
    "test": "bun test --timeout 15000 tests",
    "audit:zi": "bun scripts/audit_zi_ids.mjs",
    "check:zi-parity": "bun scripts/check_zi_parity.mjs",
    "types": "node scripts/emit-types.mjs",
    "check": "tsrs -p tsconfig.json --noEmit && tsrs -p tsconfig.worker.json --noEmit && svelte-check --tsconfig ./tsconfig.svelte.json --threshold warning",
    "i18n": "x18n check",
    "verify": "bun run test && bun run check && bun run i18n",
    "dev": "vite demo",
    "build:subtrees": "node scripts/build_subtree_parts.mjs",
    "build:demo": "vite build demo",
    "build:example-drawings": "bun demo/scripts/build-example-drawings.mjs",
    "build:sketch-parts": "uv run scripts/build_sketch_parts.py",
    "preview": "vite preview demo",
    "prepack": "node scripts/emit-types.mjs",
    "build:tangut-layers": "node scripts/build_tangut_layers.mjs",
    "check:demo": "bun scripts/check-demo.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/bun": "1.3.14",
    "@x18n/cli": "0.1.1",
    "onnxruntime-web": "1.23.0",
    "playwright-core": "1.64.1",
    "qrcode-generator": "1.4.4",
    "svelte": "5.57.0",
    "svelte-check": "4.7.7",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "wrangler": "4.156.0"
  },
  "peerDependencies": {
    "svelte": "^5.20.0"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  }
}
