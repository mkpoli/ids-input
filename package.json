{
  "name": "ids-input",
  "version": "0.1.2",
  "description": "Headless editing of ideographic description sequences (IDS): parse, write and edit IDS trees, with Svelte components for an editor, a parts palette, a decomposition browser and a preview drawn by han-compose.",
  "license": "MIT",
  "author": "mkpoli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mkpoli/ids-input.git"
  },
  "homepage": "https://ids.mkpo.li/",
  "keywords": [
    "ids",
    "ideographic description sequence",
    "cjk",
    "han",
    "kanji",
    "hanzi",
    "input",
    "svelte"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./types/core/index.d.ts",
      "default": "./src/core/index.js"
    },
    "./adapter": {
      "types": "./types/adapter/index.d.ts",
      "default": "./src/adapter/index.js"
    },
    "./composer": {
      "types": "./types/composer/index.d.ts",
      "default": "./src/composer/index.js"
    },
    "./document": {
      "types": "./types/document/index.d.ts",
      "default": "./src/document/index.js"
    },
    "./svelte": {
      "svelte": "./src/svelte/index.js",
      "default": "./src/svelte/index.js"
    },
    "./messages/*": "./messages/*",
    "./fonts.css": "./fonts/fonts.css",
    "./design.css": "./design/index.css",
    "./design/*": "./design/*",
    "./fonts/*": "./fonts/*",
    "./data/*": "./data/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "types",
    "data",
    "fonts",
    "messages",
    "scripts",
    "design",
    "LICENSE",
    "README.md",
    "docs/document-format.md",
    "docs/gongche-coverage.md",
    "docs/small-seal-candidates.md",
    "docs/ids-document.schema.json",
    "docs/ids-document.example.json"
  ],
  "scripts": {
    "test": "bun test --timeout 15000 tests",
    "audit:zi": "bun scripts/audit_zi_ids.mjs",
    "check:zi-parity": "bun scripts/check_zi_parity.mjs",
    "check:coverage": "bun scripts/check_coverage_freshness.mjs",
    "types": "node scripts/emit-types.mjs",
    "check": "tsrs -p tsconfig.json --noEmit && tsrs -p tsconfig.worker.json --noEmit && svelte-check --tsconfig ./tsconfig.svelte.json --threshold warning",
    "lint": "oxlint src demo scripts tests worker",
    "i18n": "x18n check",
    "verify": "bun run test && bun run check && bun run i18n",
    "coverage": "bun scripts/audit_render_coverage.mjs cache/coverage-sans docs/coverage/sans.json sans && bun scripts/audit_render_coverage.mjs cache/coverage-serif docs/coverage/serif.json serif && bun scripts/audit_render_coverage.mjs cache/coverage-fangsong docs/coverage/fangsong.json fangsong && bun scripts/audit_render_coverage.mjs cache/coverage-klee docs/coverage/klee.json klee",
    "dev": "vite demo",
    "build:subtrees": "node scripts/build_subtree_parts.mjs",
    "build:demo": "vite build demo",
    "dev:desktop-page": "VITE_DESKTOP=1 vite demo",
    "build:desktop-page": "VITE_DESKTOP=1 vite build demo",
    "desktop:atlas": "bun desktop/scripts/fetch-atlas.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "build:site": "bun run build:demo && bun scripts/og-assets.mjs && bun scripts/build-og-worker.mjs && bun scripts/build-sitemap.mjs",
    "build:example-drawings": "bun demo/scripts/build-example-drawings.mjs",
    "build:sketch-parts": "uv run scripts/build_sketch_parts.py",
    "preview": "vite preview demo",
    "dev:worker": "bunx wrangler dev",
    "prepack": "node scripts/emit-types.mjs",
    "build:tangut-layers": "node scripts/build_tangut_layers.mjs",
    "check:demo": "bun scripts/check-demo.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/bun": "1.4.4",
    "@x18n/cli": "0.1.13",
    "miniflare": "5.20261023.3-beta",
    "onnxruntime-web": "1.23.0",
    "oxlint": "1.91.0",
    "playwright-core": "1.65.0",
    "qrcode-generator": "1.4.4",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "tsrs": "0.22.0-ts7.1.0-beta",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "wrangler": "4.158.0"
  },
  "peerDependencies": {
    "svelte": "^5.20.0"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  },
  "dependencies": {
    "@cf-wasm/resvg": "^0.4.0"
  }
}
