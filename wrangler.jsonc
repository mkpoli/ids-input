{
  "name": "ids-input-workshop",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-30",
  // The drawing engine names its data files against its module URL. A bundled Worker has no such
  // URL (workerd gives the bare module name, which `new URL` refuses), so it is given a base; the
  // Worker reads those files from its own assets by path and never fetches these URLs.
  "define": { "import.meta.url": "\"https://assets/og/module.js\"" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    // The worker answers a miss itself: the app for a sequence, 404 otherwise. An
    // SPA fallback here would resolve the miss before the worker ever sees it.
    "not_found_handling": "none"
  },
  "routes": [{ "pattern": "ids.mkpo.li", "custom_domain": true }],
  // The anonymous bug report intake, reached as /api/report.
  "services": [{ "binding": "REPORT", "service": "ids-reports" }],
  "workers_dev": false,
  "observability": { "enabled": true },
  "preview_urls": true
}
