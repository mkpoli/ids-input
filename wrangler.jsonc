{
  "name": "ids-input-workshop",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-30",
  // The drawing engine names its data files by URLs beside its own module. A bundled Worker has no
  // module URL, so the bundle is given one; the files themselves are read from /og/data/.
  "define": { "import.meta.url": "\"https://assets/worker/index.js\"" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    // The worker answers a miss itself: the app for a sequence, 404 otherwise. An
    // SPA fallback here would resolve the miss before the worker ever sees it.
    "not_found_handling": "none"
  },
  "routes": [{ "pattern": "ids.mkpo.li", "custom_domain": true }],
  // The anonymous bug report intake, reached as /api/report.
  "services": [{ "binding": "REPORT", "service": "ids-reports" }],
  "workers_dev": false,
  "observability": { "enabled": true },
  "preview_urls": true
}
