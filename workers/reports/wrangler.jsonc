{
  // The anonymous bug report intake for https://ids.mkpo.li. GITHUB_TOKEN, and the optional
  // TURNSTILE_SECRET, are secrets: set them with `bunx wrangler secret put <name>`.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ids-reports",
  "main": "src/index.js",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "preview_urls": true,
  // The endpoint keeps a host of its own for `curl` and for a page served from elsewhere; the
  // workshop itself posts to /api/report on its origin, which the hosting worker hands here.
  "routes": [
    {
      "pattern": "report.ids.mkpo.li",
      "custom_domain": true
    }
  ],
  "observability": { "enabled": true },
  "kv_namespaces": [
    {
      "binding": "REPORTS",
      "id": "890a1389b87f4ef9915a7774605c7de5"
    }
  ],
  "vars": {
    "REPO": "mkpoli/ids-input",
    "SITE_ORIGIN": "https://ids.mkpo.li"
  }
}
