{
  "$schema": "https://x18n.dev/schema/config.json",
  "sourceLocale": "en",
  "resources": [
    { "pattern": "messages/{locale}.json", "namespace": "core" },
    { "pattern": "demo/messages/{locale}.json", "namespace": "demo" }
  ],
  "namespace": { "separator": ":", "default": "core", "byFile": { "demo/**": "demo" }, "fallback": ["core"] },
  "keyStyle": "flat",
  "plugins": ["./.x18n/placeholders.x18n-plugin.yml"],
  "usage": {
    "include": ["src/svelte/**", "demo/*.svelte", "demo/ui/**", "demo/lib/**"],
    "calls": [{ "callee": "t" }, { "callee": "editor.t" }],
    "derivedKeys": ["{key}.{plural}"],
    "keysInUse": [
      "core:parts.hangul.consonants",
      "core:parts.hangul.finals",
      "core:parts.hangul.jamo",
      "core:parts.hangul.syllable",
      "core:parts.hangul.vowels",
      "demo:app.inspired.chise",
      "demo:app.inspired.mojidata",
      "demo:app.inspired.yedict",
      "demo:app.inspired.zitools",
      "demo:app.source.babelstone",
      "demo:app.source.casia",
      "demo:app.source.characterDataPresentation",
      "demo:app.source.daKanji",
      "demo:app.source.emnist",
      "demo:app.source.etl",
      "demo:app.source.glyphWeave",
      "demo:app.source.hanCompose",
      "demo:app.source.hanReassemble",
      "demo:app.source.hfhchan",
      "demo:app.source.kanjivg",
      "demo:app.source.newKoreanLetters",
      "demo:app.source.noto",
      "demo:app.source.openTangut",
      "demo:app.source.onnxRuntime",
      "demo:app.source.plangothic",
      "demo:app.source.qrcode",
      "demo:app.source.rime",
      "demo:app.source.scriptHybrid",
      "demo:app.source.sealFont",
      "demo:app.source.shuishuGlyphs",
      "demo:app.source.shuishuIndex",
      "demo:app.source.shuishuReadings",
      "demo:app.source.smallSeal",
      "demo:app.source.tangut",
      "demo:app.source.tangutComponentMeaning",
      "demo:app.source.unihan",
      "demo:app.source.ziToolsPresentation",
      "demo:sources.tag.dictionary",
      "demo:sources.tag.engine",
      "demo:sources.tag.forms",
      "demo:sources.tag.ids",
      "demo:sources.tag.irg",
      "demo:sources.tag.korean",
      "demo:sources.tag.names",
      "demo:sources.tag.recognition",
      "demo:sources.tag.seal",
      "demo:sources.tag.shuishu",
      "demo:sources.tag.social",
      "demo:sources.tag.strokes",
      "demo:sources.tag.tangut",
      "demo:sources.tag.unicode",
      "demo:sources.tag.unihan",
      "demo:sources.tag.wikipedia",
      "demo:sources.use.compare",
      "demo:sources.use.composer",
      "demo:sources.use.decompose",
      "demo:sources.use.examples",
      "demo:sources.use.export",
      "demo:sources.use.fonts",
      "demo:sources.use.info",
      "demo:sources.use.palette",
      "demo:sources.use.recognition",
      "demo:sources.use.search",
      "demo:sources.use.share"
    ]
  },
  "checks": { "missing-translation": "error", "empty-translation": "error" }
}
